#!/usr/bin/env bash

set -euo pipefail

if [ ! "$#" -gt 0 ]; then
  echo "Need a string to search for!"
  exit 1
fi

FIF_PATTERN=$1
export FIF_PATTERN

# shellcheck disable=SC2016
rg --hidden --glob '!.git' --files-with-matches --no-messages -- "$FIF_PATTERN" |
  fzf \
    --scheme=path \
    --preview='rg --pretty --context 10 -- "$FIF_PATTERN" {}'
